{
    "name": "tidy-tsc",
    "version": "0.0.4",
    "description": "Tidy up tsc (TypeScript compiler) CLI output.",
    "keywords": [
        "tsc",
        "cli",
        "output",
        "clean",
        "vir"
    ],
    "homepage": "https://github.com/electrovir/tidy-tsc",
    "bugs": {
        "url": "https://github.com/electrovir/tidy-tsc/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/tidy-tsc.git"
    },
    "license": "(MIT or CC0 1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "type": "module",
    "bin": {
        "tidyt": "bin.js"
    },
    "scripts": {
        "compile": "virmator compile",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "test": "virmator test node",
        "test:all": "npm run compile && concurrently --colors --kill-others-on-fail -c auto --names tests,spelling,format,deps,lint \"npm test\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:deps": "virmator deps check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "npm run test update"
    },
    "dependencies": {
        "@augment-vir/assert": "^31.7.2",
        "@augment-vir/common": "^31.8.0",
        "@augment-vir/node": "^31.8.0",
        "tsx": "^4.19.2"
    },
    "devDependencies": {
        "@augment-vir/test": "^31.8.0",
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.14.0",
        "@stylistic/eslint-plugin": "^2.13.0",
        "@stylistic/eslint-plugin-ts": "^2.13.0",
        "@types/node": "^22.10.9",
        "@typescript-eslint/eslint-plugin": "^8.21.0",
        "cspell": "^8.17.2",
        "dependency-cruiser": "^16.9.0",
        "esbuild": "^0.24.2",
        "eslint": "^9.14.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-jsdoc": "^50.6.2",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.1.0",
        "eslint-plugin-prettier": "^5.2.3",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^3.0.1",
        "eslint-plugin-unicorn": "^56.0.1",
        "markdown-code-example-inserter": "^3.0.3",
        "npm-check-updates": "^17.1.14",
        "prettier": "^3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.0",
        "prettier-plugin-jsdoc": "^1.3.2",
        "prettier-plugin-multiline-arrays": "^4.0.2",
        "prettier-plugin-organize-imports": "^4.1.0",
        "prettier-plugin-packagejson": "^2.5.8",
        "prettier-plugin-sort-json": "^4.1.1",
        "prettier-plugin-toml": "^2.0.1",
        "typedoc": "^0.27.6",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.21.0",
        "virmator": "^13.12.0"
    },
    "engines": {
        "node": ">=22"
    }
}
